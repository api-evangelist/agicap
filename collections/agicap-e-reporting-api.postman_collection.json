                  "value": "{{bearerToken}}"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category\": \"<string>\",\n  \"currencyCode\": \"<string>\",\n  \"entityId\": \"<integer>\",\n  \"legalRegistrationId\": \"<string>\",\n  \"transactionDate\": \"<date>\",\n  \"transactionDetails\": [\n    {\n      \"taxableAmount\": \"<double>\",\n      \"taxRate\": \"<double>\"\n    },\n    {\n      \"taxableAmount\": \"<double>\",\n      \"taxRate\": \"<double>\"\n    }\n  ]\n}",

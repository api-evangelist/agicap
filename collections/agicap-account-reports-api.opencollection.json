{
  "opencollection": "1.0.0",
  "info": {
    "name": "Clients AR Account reports API",
    "version": "v1"
  },
  "items": [
    {
      "info": {
        "name": "Account reports",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List account reports",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.agicap.com/public/banking-documents/v1/entities/:entityId/connections/:connectionId/account-reports",
            "params": [
              {
                "name": "entityId",
                "value": "",
                "type": "path",
                "description": "Agicap entity identifier"
              },
              {
                "name": "connectionId",
                "value": "",
                "type": "path",
                "description": "Connection identifier"
              },
              {
                "name": "format",
                "value": "",
                "type": "query",
                "description": "Bank file format"
              },
              {
                "name": "createdSince",
                "value": "",
                "type": "query",
                "description": "Will return only account reports created **after** this date"
              },
              {
                "name": "createdUntil",
                "value": "",
                "type": "query",
                "description": "Will return only account reports created **before** this date"
              },
              {
                "name": "fileId",
                "value": "",
                "type": "query",
                "description": "File identifier"
              },
              {
                "name": "accountNumber",
                "value": "",
                "type": "query",
                "description": "Will return only account reports of this account number"
              },
              {
                "name": "PageNumber",
                "value": "",
                "type": "query"
              },
              {
                "name": "PageSize",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "List account reports"
        },
        {
          "info": {
            "name": "Download an account report",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.agicap.com/public/banking-documents/v1/entities/:entityId/connections/:connectionId/account-reports/:accountReportId",
            "params": [
              {
                "name": "entityId",
                "value": "",
                "type": "path",
                "description": "Agicap entity identifier"
              },
              {
                "name": "connectionId",
                "value": "",
                "type": "path",
                "description": "Connection identifier"
              },
              {
                "name": "accountReportId",
                "value": "",
                "type": "path",
                "description": "Account report identifier"
              }
            ]
          },
          "docs": "Download an account report"
        }
      ]
    }
  ],
  "bundled": true
}